# Copy to /etc/private-chatroom/private-chatroom.env on the server.
# Keep this file root:chatroom 0640. Never commit the real token.

PC_HOST=127.0.0.1
PC_PORT=8443
PC_PUBLIC_PREFIX=/Pchat
PC_API_PREFIX=/pc/api
PC_WS_PATH=/pc/ws
PC_SERVER_URL=https://flshw.online
PC_DATA_DIR=/var/lib/private-chatroom
PC_KEYS_DIR=/var/lib/private-chatroom/keys
PC_LOG_DIR=/var/lib/private-chatroom/logs
PC_QUOTA_ROOMS=3
PC_HARD_MAX_MEMBERS=20
PC_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE
